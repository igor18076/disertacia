# Пароль PostgreSQL для этой установки.
POSTGRES_PASSWORD=
POSTGRES_USER=coursegen
POSTGRES_DB=coursegen

# Порт на 127.0.0.1 хоста и таймаут проверки одной зависимости в секундах.
API_PORT=8000
PROBE_TIMEOUT_SECONDS=3

# Верхние пределы CPU и памяти для каждого контейнера.
API_CPUS=2
API_MEMORY=4g
POSTGRES_CPUS=2
POSTGRES_MEMORY=4g
QDRANT_CPUS=4
QDRANT_MEMORY=12g
MIGRATE_CPUS=1
MIGRATE_MEMORY=512m
TEST_CPUS=2
TEST_MEMORY=2g
WORKER_CPUS=2
WORKER_MEMORY=2g

# Лимиты на один файл и параметры обработки новых версий документов.
DOCUMENT_MAX_BYTES=16777216
DOCUMENT_MAX_PAGES=2000
DOCUMENT_MAX_TEXT_CHARS=8000000
CHUNK_STRATEGY=section
CHUNK_SIZE=800
CHUNK_OVERLAP=0.12
WORKER_POLL_SECONDS=1
